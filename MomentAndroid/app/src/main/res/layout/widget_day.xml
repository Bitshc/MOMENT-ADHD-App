<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1"
 android:orientation="vertical" android:gravity="top|center_horizontal" android:padding="2dp">
 <TextView android:id="@+id/day_label"
  android:layout_width="match_parent" android:layout_height="24dp"
  android:gravity="center" android:text="12" android:textSize="12sp"
  android:textColor="#30264B" android:singleLine="true"/>
 <TextView android:id="@+id/day_event"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:maxLines="2" android:ellipsize="end" android:gravity="center"
  android:text="" android:textSize="9sp" android:textColor="#51436A"
  android:padding="1dp"/>
</LinearLayout>